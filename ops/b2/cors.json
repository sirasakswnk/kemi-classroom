[
  {
    "corsRuleName": "kemi-web",
    "allowedOrigins": [
      "https://kemi-classroom.pages.dev",
      "https://*.kemi-classroom.pages.dev",
      "http://localhost:5173"
    ],
    "allowedOperations": ["s3_get", "s3_head", "s3_put"],
    "allowedHeaders": ["content-type", "content-length"],
    "exposeHeaders": ["ETag", "x-amz-version-id"],
    "maxAgeSeconds": 3600
  }
]
