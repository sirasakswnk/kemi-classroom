# Security headers ของ Cloudflare Pages — TECHNICAL_BUILD_PLAN ส่วน 6
# __SUPABASE_ORIGIN__ ถูกแทนด้วย origin ของ VITE_SUPABASE_URL ตอน build (vite.config.ts)
# เพื่อให้ connect-src อนุญาตเฉพาะ Supabase ของสภาพแวดล้อมนั้น (preview = kemi-dev, production = kemi-prod)
# endpoint S3 ของ B2 (dev และ prod ใช้ endpoint เดียวกัน) อยู่ใน connect-src: โหลดไฟล์ด้วย fetch แล้วแสดงเป็น blob: (P3-05)
# และ PUT อัปโหลด (P3-06) — img-src ไม่ต้องเพิ่มเพราะตัวดูแสดงจาก blob:
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' blob: data:; connect-src 'self' __SUPABASE_ORIGIN__ https://s3.eu-central-003.backblazeb2.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# ไฟล์ที่ชื่อมี hash เก็บ cache ได้ยาว (index.html ไม่ cache ตามค่าเริ่มต้นของ Pages)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
